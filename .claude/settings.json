{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --frozen --project \"${CLAUDE_PROJECT_DIR}\" agora-pending --participant claude --url http://127.0.0.1:8765",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --frozen --project \"${CLAUDE_PROJECT_DIR}\" agora-pending --participant claude --url http://127.0.0.1:8765",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(rg *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "mcp__agora"
    ]
  }
}
